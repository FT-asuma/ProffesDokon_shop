<%- include('../partials/header') %>
      <div class="container mx-auto p-6 bg-white theme-<%= theme || 'light' %>">
        <h1 class="text-3xl font-bold mb-6 flex items-center">
          <i class="fas fa-edit mr-2 text-blue-500"></i> Edit Product
        </h1>
        <% if (error) { %>
          <p class="text-red-600 bg-red-100 p-4 rounded-lg mb-6 flex items-center">
            <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
          </p>
        <% } %>
        <form id="editForm" action="/admin/edit/<%= product.id %>" method="POST" class="space-y-6">
          <!-- Basic Information -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-info-circle mr-2 text-blue-500"></i> Basic Information
            </h2>
            <div class="space-y-4">
              <div>
                <label for="name" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-tag mr-1 text-gray-500"></i> Product Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  value="<%= product.name || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="price" class="block font-medium mb-1 flex items-center">
                    <i class="fas fa-dollar-sign mr-1 text-gray-500"></i> Price
                  </label>
                  <input
                    type="number"
                    id="price"
                    name="price"
                    step="0.01"
                    value="<%= product.price != null && typeof product.price === 'number' ? product.price.toFixed(2) : '' %>"
                    class="w-full p-3 input rounded-lg"
                    required
                  >
                </div>
                <div>
                  <label for="currency" class="block font-medium mb-1 flex items-center">
                    <i class="fas fa-coins mr-1 text-gray-500"></i> Currency
                  </label>
                  <select id="currency" name="currency" class="w-full p-3 input rounded-lg">
                    <option value="USD" <%= product.currency === 'USD' ? 'selected' : '' %>>USD</option>
                    <option value="UZS" <%= product.currency === 'UZS' ? 'selected' : '' %>>UZS</option>
                    <option value="RUB" <%= product.currency === 'RUB' ? 'selected' : '' %>>RUB</option>
                  </select>
                </div>
              </div>
              <div>
                <label for="availableStock" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-boxes mr-1 text-gray-500"></i> Available Stock
                </label>
                <input
                  type="number"
                  id="availableStock"
                  name="availableStock"
                  value="<%= product.availableStock != null ? product.availableStock : '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
            </div>
          </div>
      
          <!-- Thumbnail Upload -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-image mr-2 text-blue-500"></i> Main Thumbnail
            </h2>
            <div
              class="drop-zone p-6 rounded-lg border-2 border-dashed border-gray-300 text-center"
              id="thumbnailDropZone"
            >
              <p class="text-gray-500"><i class="fas fa-upload mr-1"></i> Drag and drop or click to upload thumbnail</p>
              <input type="file" id="thumbnailInput" accept="image/*" class="hidden">
            </div>
            <div id="thumbnailPreview" class="flex flex-wrap gap-4 mt-4">
              <% if (product.image) { %>
                <div class="relative">
                  <img
                    src="<%= product.image %>"
                    alt="Current Thumbnail"
                    class="w-24 h-24 object-cover rounded-md shadow"
                  >
                  <button
                    type="button"
                    class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600"
                    onclick="this.parentElement.remove(); addDeleteImage('<%= product.image %>')"
                  >
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              <% } %>
            </div>
            <input type="hidden" name="thumbnailUrl" id="thumbnailUrl">
          </div>
      
          <!-- Extra Images Upload -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-images mr-2 text-blue-500"></i> Extra Images
            </h2>
            <div class="flex flex-wrap gap-4 mb-4">
              <% (product.images || []).forEach(img => { %>
                <div class="relative">
                  <img
                    src="<%= img %>"
                    alt="Current Image"
                    class="w-24 h-24 object-cover rounded-md shadow"
                  >
                  <button
                    type="button"
                    class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600"
                    onclick="this.parentElement.remove(); addDeleteImage('<%= img %>')"
                  >
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              <% }) %>
            </div>
            <div
              class="drop-zone p-6 rounded-lg border-2 border-dashed border-gray-300 text-center"
              id="imagesDropZone"
            >
              <p class="text-gray-500"><i class="fas fa-upload mr-1"></i> Drag and drop or click to upload images</p>
              <input type="file" id="imagesInput" multiple accept="image/*" class="hidden">
            </div>
            <div id="imagesPreview" class="flex flex-wrap gap-4 mt-4"></div>
            <input type="hidden" name="imageUrls" id="imageUrls">
          </div>
      
          <!-- Discount -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-tags mr-2 text-blue-500"></i> Discount
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="discountPrice" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-dollar-sign mr-1 text-gray-500"></i> Discount Price
                </label>
                <input
                  type="number"
                  id="discountPrice"
                  name="discountPrice"
                  step="0.01"
                  value="<%= product.discount?.price != null ? product.discount.price.toFixed(2) : '' %>"
                  class="w-full p-3 input rounded-lg"
                >
              </div>
              <div>
                <label for="discountDays" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-clock mr-1 text-gray-500"></i> Discount Duration (days)
                </label>
                <input
                  type="number"
                  id="discountDays"
                  name="discountDays"
                  placeholder="Days"
                  min="0"
                  value="<%= product.discount?.endDate ? Math.ceil((new Date(product.discount.endDate) - new Date()) / (1000 * 60 * 60 * 24)) : '' %>"
                  class="w-full p-3 input rounded-lg"
                >
              </div>
            </div>
          </div>
      
          <!-- Seller Info -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-store mr-2 text-blue-500"></i> Seller Information
            </h2>
            <div class="space-y-4">
              <div>
                <label for="sellerName" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-user mr-1 text-gray-500"></i> Seller Name
                </label>
                <input
                  type="text"
                  id="sellerName"
                  name="sellerName"
                  value="<%= product.seller?.name || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
              <div>
                <label for="sellerPhone" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-phone mr-1 text-gray-500"></i> Seller Phone
                </label>
                <input
                  type="text"
                  id="sellerPhone"
                  name="sellerPhone"
                  value="<%= product.seller?.phone || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
              <div>
                <label for="sellerTelegram" class="block font-medium mb-1 flex items-center">
                  <i class="fab fa-telegram mr-1 text-gray-500"></i> Seller Telegram
                </label>
                <input
                  type="text"
                  id="sellerTelegram"
                  name="sellerTelegram"
                  value="<%= product.seller?.telegram || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
              <div>
                <label for="sellerContactUrl" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-link mr-1 text-gray-500"></i> Seller Contact URL
                </label>
                <input
                  type="text"
                  id="sellerContactUrl"
                  name="sellerContactUrl"
                  value="<%= product.seller?.contactUrl || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
              </div>
            </div>
          </div>
      
          <!-- Additional Details -->
          <div class="card p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4 flex items-center">
              <i class="fas fa-list mr-2 text-blue-500"></i> Additional Details
            </h2>
            <div class="space-y-4">
              <div>
                <label for="description" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-file-alt mr-1 text-gray-500"></i> Description
                </label>
                <textarea
                  id="description"
                  name="description"
                  rows="4"
                  class="w-full p-3 input rounded-lg"
                ><%= product.description || '' %></textarea>
              </div>
              <div>
                <label for="categoryInput" class="block font-medium mb-1 flex items-center">
                  <i class="fas fa-folder mr-1 text-gray-500"></i> Category
                </label>
                <input
                  type="text"
                  id="categoryInput"
                  name="category"
                  value="<%= product.category || '' %>"
                  class="w-full p-3 input rounded-lg"
                  required
                >
                <div id="categorySuggestions" class="mt-2 flex flex-wrap gap-2"></div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="kilowatts" class="block font-medium mb-1 flex items-center">
                    <i class="fas fa-bolt mr-1 text-gray-500"></i> Kilowatts
                  </label>
                  <input
                    type="number"
                    id="kilowatts"
                    name="kilowatts"
                    step="0.1"
                    value="<%= product.specifications?.kilowatts != null ? product.specifications.kilowatts : '' %>"
                    class="w-full p-3 input rounded-lg"
                  >
                </div>
                <div>
                  <label for="madeIn" class="block font-medium mb-1 flex items-center">
                    <i class="fas fa-globe mr-1 text-gray-500"></i> Made In
                  </label>
                  <input
                    type="text"
                    id="madeIn"
                    name="madeIn"
                    value="<%= product.specifications?.madeIn || '' %>"
                    class="w-full p-3 input rounded-lg"
                  >
                </div>
              </div>
              <div id="detailsContainer" class="space-y-4">
                <% Object.entries(product.specifications?.details || {}).forEach(([name, value]) => { %>
                  <div class="flex items-center space-x-2 detail-row">
                    <input
                      type="text"
                      name="detailName[]"
                      value="<%= name %>"
                      placeholder="Detail Name"
                      class="flex-1 p-3 input rounded-lg"
                    >
                    <input
                      type="text"
                      name="detailValue[]"
                      value="<%= value %>"
                      placeholder="Detail Value"
                      class="flex-1 p-3 input rounded-lg"
                    >
                    <button
                      type="button"
                      class="bg-red-500 text-white px-3 py-2 rounded-lg hover:bg-red-600"
                      onclick="this.parentElement.remove()"
                    >
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                <% }) %>
              </div>
              <button
                type="button"
                id="addDetail"
                class="btn-primary px-4 py-2 rounded-lg flex items-center"
              >
                <i class="fas fa-plus mr-1"></i> Add Detail
              </button>
            </div>
          </div>
      
          <!-- Hidden field for deleted images -->
          <input type="hidden" name="deleteImages" id="deleteImagesInput" value="">
      
          <!-- Submit -->
          <button
            type="submit"
            class="w-full btn-primary p-4 rounded-lg font-semibold flex items-center justify-center"
          >
            <i class="fas fa-save mr-2"></i> Update Product
          </button>
        </form>
      </div>
      
      <script>
      // ImgBB API key (temporary; move to server-side for production)
      const IMGBB_API_KEY = "<%= process.env.IMGBB_API_KEY || 'your-imgbb-api-key-here' %>";
      
      // Category suggestions
      const dbCategories = <%- JSON.stringify(categories || []) %>;
      const categoryInput = document.getElementById('categoryInput');
      const suggestionsDiv = document.getElementById('categorySuggestions');
      
      categoryInput.addEventListener('input', () => {
        const value = categoryInput.value.toLowerCase();
        suggestionsDiv.innerHTML = '';
        if (value) {
          dbCategories
            .filter(cat => cat.toLowerCase().includes(value))
            .slice(0, 5)
            .forEach(cat => {
              const tag = document.createElement('span');
              tag.className = 'bg-blue-100 text-blue-800 px-3 py-1 rounded-full cursor-pointer hover:bg-blue-200';
              tag.textContent = cat;
              tag.onclick = () => {
                categoryInput.value = cat;
                suggestionsDiv.innerHTML = '';
              };
              suggestionsDiv.appendChild(tag);
            });
        }
      });
      
      // Thumbnail upload
      const thumbnailDropZone = document.getElementById('thumbnailDropZone');
      const thumbnailInput = document.getElementById('thumbnailInput');
      const thumbnailPreview = document.getElementById('thumbnailPreview');
      const thumbnailUrlInput = document.getElementById('thumbnailUrl');
      
      thumbnailDropZone.addEventListener('click', () => thumbnailInput.click());
      thumbnailDropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        thumbnailDropZone.classList.add('border-blue-500');
      });
      thumbnailDropZone.addEventListener('dragleave', () => {
        thumbnailDropZone.classList.remove('border-blue-500');
      });
      thumbnailDropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        thumbnailDropZone.classList.remove('border-blue-500');
        thumbnailInput.files = e.dataTransfer.files;
        uploadThumbnail();
      });
      thumbnailInput.addEventListener('change', uploadThumbnail);
      
      async function uploadThumbnail() {
        if (!thumbnailInput.files[0]) return;
        const file = thumbnailInput.files[0];
        const formData = new FormData();
        formData.append('image', file);
      
        try {
          const response = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, {
            method: 'POST',
            body: formData,
          });
          const data = await response.json();
          if (data.success) {
            thumbnailUrlInput.value = data.data.url;
            thumbnailPreview.innerHTML = `
              <div class="relative">
                <img src="${data.data.url}" alt="Preview" class="w-24 h-24 object-cover rounded-md shadow">
                <button type="button" class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600" onclick="thumbnailInput.value=''; thumbnailUrlInput.value=''; thumbnailPreview.innerHTML=''">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            `;
          } else {
            alert('Thumbnail upload failed: ' + (data.error?.message || 'Unknown error'));
          }
        } catch (err) {
          alert('Thumbnail upload error: ' + err.message);
        }
      }
      
      // Extra images upload
      const imagesDropZone = document.getElementById('imagesDropZone');
      const imagesInput = document.getElementById('imagesInput');
      const imagesPreview = document.getElementById('imagesPreview');
      const imageUrlsInput = document.getElementById('imageUrls');
      let imageUrls = [];
      
      imagesDropZone.addEventListener('click', () => imagesInput.click());
      imagesDropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        imagesDropZone.classList.add('border-blue-500');
      });
      imagesDropZone.addEventListener('dragleave', () => {
        imagesDropZone.classList.remove('border-blue-500');
      });
      imagesDropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        imagesDropZone.classList.remove('border-blue-500');
        imagesInput.files = e.dataTransfer.files;
        uploadImages();
      });
      imagesInput.addEventListener('change', uploadImages);
      
      async function uploadImages() {
        imagesPreview.innerHTML = '';
        imageUrls = [];
        const files = Array.from(imagesInput.files);
      
        for (const file of files) {
          const formData = new FormData();
          formData.append('image', file);
          try {
            const response = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, {
              method: 'POST',
              body: formData,
            });
            const data = await response.json();
            if (data.success) {
              imageUrls.push(data.data.url);
              const div = document.createElement('div');
              div.className = 'relative';
              div.innerHTML = `
                <img src="${data.data.url}" alt="Preview" class="w-24 h-24 object-cover rounded-md shadow">
                <button type="button" class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600" onclick="removeImage('${data.data.url}')">
                  <i class="fas fa-times"></i>
                </button>
              `;
              imagesPreview.appendChild(div);
            } else {
              alert('Image upload failed: ' + (data.error?.message || 'Unknown error'));
            }
          } catch (err) {
            alert('Image upload error: ' + err.message);
          }
        }
        imageUrlsInput.value = imageUrls.join(',');
      }
      
      function removeImage(url) {
        imageUrls = imageUrls.filter(u => u !== url);
        imageUrlsInput.value = imageUrls.join(',');
        updateImagesPreview();
      }
      
      function updateImagesPreview() {
        imagesPreview.innerHTML = '';
        imageUrls.forEach((url, index) => {
          const div = document.createElement('div');
          div.className = 'relative';
          div.innerHTML = `
            <img src="${url}" alt="Preview" class="w-24 h-24 object-cover rounded-md shadow">
            <button type="button" class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600" onclick="removeImage('${url}')">
              <i class="fas fa-times"></i>
            </button>
          `;
          imagesPreview.appendChild(div);
        });
      }
      
      // Track deleted images
      let deleteImages = [];
      function addDeleteImage(url) {
        deleteImages.push(url);
        document.getElementById('deleteImagesInput').value = deleteImages.join(',');
      }
      
      // Dynamic details
      const detailsContainer = document.getElementById('detailsContainer');
      document.getElementById('addDetail').addEventListener('click', () => {
        const div = document.createElement('div');
        div.className = 'flex items-center space-x-2 detail-row';
        div.innerHTML = `
          <input type="text" name="detailName[]" placeholder="Detail Name" class="flex-1 p-3 input rounded-lg">
          <input type="text" name="detailValue[]" placeholder="Detail Value" class="flex-1 p-3 input rounded-lg">
          <button type="button" class="bg-red-500 text-white px-3 py-2 rounded-lg hover:bg-red-600" onclick="this.parentElement.remove()">
            <i class="fas fa-trash"></i>
          </button>
        `;
        detailsContainer.appendChild(div);
      });
      
      // Form submission
      document.getElementById('editForm').addEventListener('submit', (e) => {
        if (!thumbnailUrlInput.value && !document.querySelector('#thumbnailPreview img')) {
          e.preventDefault();
          alert('Please upload a thumbnail image.');
        }
      });
      </script>
      <%- include('../partials/footer') %>