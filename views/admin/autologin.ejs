<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - ProffesDokon</title>
    <link
      rel="icon"
      href="/images/icon.jpg"
      type="image/jpeg"
      sizes="512x512"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/theme.css" />
  </head>
  <body
    class="theme-<%= theme %> font-sans min-h-screen flex items-center justify-center"
  >
    <div class="card p-8 rounded-xl shadow-lg max-w-md w-full text-center">
      <i
        class="fas fa-spinner autologin-spinner text-4xl text-blue-500 mb-4"
      ></i>
      <p class="text-lg"><%= __('redirecting_to_dashboard') %></p>
    </div>
    <script>
      setTimeout(() => {
        window.location.href = "/admin/dashboard";
      }, 1000);
    </script>
  </body>
</html>
