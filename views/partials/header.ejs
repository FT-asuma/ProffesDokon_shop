<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/theme.css?v=<%= Date.now() %>" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <script src="/js/script.js?v=<%= Date.now() %>" defer></script>
  </head>
  <body class="theme-<%= theme || 'light' %>">
    <header class="bg-white theme-<%= theme || 'light' %> shadow">
      <nav class="container mx-auto p-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold">ShopIsh</a>
        <div class="flex items-center space-x-4">
          <a href="/" class="hover:underline">Catalog</a>
          <a href="/cart" class="hover:underline">Cart</a>
          <% if (typeof user !== 'undefined' && user) { %>
          <span class="text-gray-600"><%= user.username %></span>
          <% if (user.role === 'admin') { %>
          <a href="/admin/dashboard" class="hover:underline">Admin Panel</a>
          <% } %>
          <form action="/logout" method="POST">
            <button
              type="submit"
              class="btn-primary px-4 py-2 rounded-lg flex items-center"
            >
              <i class="fas fa-sign-out-alt mr-2"></i> Logout
            </button>
          </form>
          <% } else { %>
          <a href="/login" class="hover:underline">Login</a>
          <% } %>
          <button onclick="toggleTheme()" class="p-2 rounded">
            <i class="fas fa-moon"></i>
          </button>
        </div>
      </nav>
    </header>
    <main></main>
  </body>
</html>
