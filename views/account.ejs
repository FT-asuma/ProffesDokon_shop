<%- include('partials/header') %>
      <div class="container mx-auto p-6">
        <h1 class="text-3xl font-bold mb-6"><%= __('title_account') %></h1>
        <div class="card p-6 rounded-xl shadow-lg bg-gray-800">
          <div class="flex items-center mb-4">
            <img src="<%= user.picture || '/images/default-user.jpg' %>" alt="<%= user.name %>" class="w-16 h-16 rounded-full mr-4">
            <div>
              <h2 class="text-2xl font-semibold text-gray-200"><%= user.name %></h2>
              <p class="text-gray-400"><%= user.email %></p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-gray-300"><strong><%= __('role') %>:</strong> <%= user.role %></p>
            <a href="/logout" class="inline-block bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
              <%= __('logout') %>
            </a>
          </div>
        </div>
      </div>
      <%- include('partials/footer') %>